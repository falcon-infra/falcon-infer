include LICENSE README.md pyproject.toml setup.py p1_build.py p1_dev.py CMakeLists.txt .gitmodules
include requirements/ascend.txt requirements/build.txt
include submodule-materials.json
include docs/design/layout-migration.json
include release-profile.json
graft vllm
graft csrc
graft cmake
recursive-include tools check_p4*.py check_npu*.py check_native_layout.py validate_npu_native.py p4_*.py
global-exclude __pycache__ *.pyc *.pyo .git .git/**
prune build
prune dist
prune csrc/build
prune csrc/output
prune csrc/third_party/catlass/.git
