include LICENSE README.md pyproject.toml setup.py p1_build.py p1_dev.py CMakeLists.txt .gitmodules
include requirements/ascend.txt requirements/build.txt
graft vllm
graft ascend
recursive-include csrc *
recursive-include cmake *
global-exclude __pycache__ *.pyc *.pyo
global-exclude .git
prune build
prune dist
prune ascend/.git
prune ascend/build
prune ascend/output
prune ascend/.deps

prune ascend/legacy_patches
prune ascend/legacy_plugin
prune ascend/vllm_ascend
prune ascend/legacy_tests
